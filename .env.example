# Domain Produksi Utama (Digunakan untuk Canonical URL, Sitemap XML, Robots.txt, dan Open Graph)
NEXT_PUBLIC_SITE_URL=https://servicekulkas-mesincuci.id

# Google Search Console Verification Token (Opsional, isi kode meta google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Tag Manager Container ID (Opsional, contoh: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (Opsional, contoh: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads Conversion Tracking (Opsional, contoh: AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_WA_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=

# Meta Pixel ID untuk Facebook & Instagram Ads (Opsional, contoh: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=
